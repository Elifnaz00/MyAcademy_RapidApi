

@model RapidApi.Web.Models.HotelDetailModel

@{
    Layout = null;
    ViewData["Title"] = Model.HotelName + " | StayFinder";

    var photoUrls = Model.PhotoUrls ?? new List<string>();
    var facilities = Model.Facilities ?? new List<string>();
    var tags = Model.Tags ?? new List<string>();
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>@ViewData["Title"]</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap"
          rel="stylesheet">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
          rel="stylesheet">

    <style>
        :root {
            --sf-ink: #1B2140;
            --sf-text: #4A5070;
            --sf-muted: #7A7F9A;
            --sf-primary: #3B3FB6;
            --sf-primary-dark: #2E3195;
            --sf-primary-soft: #EEF0FC;
            --sf-bg-soft: #F5F6FA;
            --sf-line: #E6E8F0;
            --sf-radius: 18px;
        }

        body {
            font-family: "Manrope", sans-serif;
            background: var(--sf-bg-soft);
            color: var(--sf-text);
        }

        .container {
            max-width: 1200px;
        }

        .site-header {
            background: var(--sf-bg-soft);
            padding: 18px 0;
        }

        .brand {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            color: var(--sf-ink);
            font-size: 1.4rem;
            font-weight: 800;
            text-decoration: none;
        }

        .brand-mark {
            width: 40px;
            height: 40px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background: var(--sf-primary);
            color: white;
            border-radius: 12px;
        }

        .brand span:last-child span {
            color: var(--sf-primary);
        }

        .hotel-page {
            padding: 20px 0 70px;
        }

        .sf-breadcrumb {
            font-size: .85rem;
        }

            .sf-breadcrumb a {
                color: var(--sf-muted);
                text-decoration: none;
            }

            .sf-breadcrumb .active {
                color: var(--sf-ink);
                font-weight: 700;
            }

        .hotel-heading {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 20px;
            margin-bottom: 25px;
        }

        .hotel-title {
            color: var(--sf-ink);
            font-size: clamp(1.8rem, 4vw, 2.6rem);
            font-weight: 800;
            margin-bottom: 10px;
        }

        .rating-score {
            background: var(--sf-primary);
            color: white;
            padding: 13px 16px;
            border-radius: 13px;
            font-size: 1.2rem;
            font-weight: 800;
        }

        .rating-info {
            text-align: right;
        }

            .rating-info strong {
                display: block;
                color: var(--sf-ink);
            }

            .rating-info small {
                color: var(--sf-muted);
            }

        .hotel-gallery {
            display: grid;
            grid-template-columns: 2fr 1fr 1fr;
            grid-auto-rows: 190px;
            gap: 12px;
            margin-bottom: 30px;
        }

        .gallery-item {
            display: block;
            overflow: hidden;
            border-radius: var(--sf-radius);
            background: #e5e7f5;
        }

            .gallery-item:first-child {
                grid-row: span 2;
            }

            .gallery-item img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                transition: transform .3s;
            }

            .gallery-item:hover img {
                transform: scale(1.04);
            }

        .detail-block {
            background: white;
            border-radius: 20px;
            padding: 28px;
            margin-bottom: 22px;
            box-shadow: 0 3px 12px rgba(27,33,64,.04);
        }

        .block-title {
            color: var(--sf-ink);
            font-size: 1.35rem;
            font-weight: 800;
            margin-bottom: 20px;
        }

        .about-text {
            line-height: 1.8;
            white-space: pre-line;
        }

        .tag-list {
            display: flex;
            flex-wrap: wrap;
            gap: 9px;
            padding: 0;
            margin: 20px 0 0;
            list-style: none;
        }

            .tag-list li {
                background: var(--sf-primary-soft);
                color: var(--sf-primary);
                padding: 8px 13px;
                border-radius: 30px;
                font-size: .85rem;
                font-weight: 700;
            }

        .facility-item {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px;
            border-radius: 13px;
            height: 100%;
        }

            .facility-item:hover {
                background: var(--sf-bg-soft);
            }

        .facility-icon {
            width: 42px;
            height: 42px;
            border-radius: 12px;
            background: var(--sf-primary-soft);
            color: var(--sf-primary);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 1.2rem;
            flex-shrink: 0;
        }

        .facility-text strong {
            color: var(--sf-ink);
            font-size: .9rem;
            overflow-wrap: anywhere;
        }

        .photo-track {
            display: grid;
            grid-auto-flow: column;
            grid-auto-columns: calc((100% - 30px) / 3);
            gap: 15px;
            overflow-x: auto;
            scroll-behavior: smooth;
            padding-bottom: 10px;
        }

        .photo-item {
            min-width: 0;
            margin: 0;
        }

        .photo-frame {
            display: block;
            aspect-ratio: 16 / 10;
            overflow: hidden;
            border-radius: 15px;
        }

            .photo-frame img {
                width: 100%;
                height: 100%;
                object-fit: cover;
            }

        .photo-item figcaption {
            padding: 10px 3px;
            color: var(--sf-muted);
            font-size: .85rem;
        }

            .photo-item figcaption strong {
                display: block;
                color: var(--sf-ink);
            }

        .slider-btn {
            width: 42px;
            height: 42px;
            border: 0;
            border-radius: 50%;
            background: var(--sf-primary-soft);
            color: var(--sf-primary);
        }

        .site-footer {
            background: var(--sf-ink);
            color: white;
            padding: 35px 0;
        }

            .site-footer p {
                color: rgba(255,255,255,.7);
                margin: 12px 0 0;
            }

        .empty-message {
            color: var(--sf-muted);
            padding: 15px 0;
        }

        @@media(max - width: 767px)

        {
            .hotel-heading

        {
            align-items: flex-start;
            flex-direction: column;
        }

        .hotel-gallery {
            grid-template-columns: repeat(4, 1fr);
            grid-auto-rows: 90px;
        }

        .gallery-item:first-child {
            grid-column: 1 / -1;
            grid-row: auto;
            height: 220px;
        }

        .detail-block {
            padding: 20px;
        }

        .photo-track {
            grid-auto-columns: 85%;
        }

        }
    </style>
</head>

<body>

    <header class="site-header">
        <nav class="container">
            <a class="brand" asp-controller="Booking" asp-action="Index">
                <span class="brand-mark">
                    <i class="bi bi-geo-alt-fill"></i>
                </span>
                <span>Stay<span>Finder</span></span>
            </a>
        </nav>
    </header>

    <main class="hotel-page">
        <div class="container">

            <nav aria-label="breadcrumb">
                <ol class="breadcrumb sf-breadcrumb">
                    <li class="breadcrumb-item">
                        <a asp-controller="Booking" asp-action="Index">Ana Sayfa</a>
                    </li>
                    <li class="breadcrumb-item">
                        <a asp-controller="Booking" asp-action="Index">Oteller</a>
                    </li>
                    <li class="breadcrumb-item active">
                        @Model.HotelName
                    </li>
                </ol>
            </nav>

            <!-- Otel başlığı -->
            <section class="hotel-heading">
                <div>
                    <h1 class="hotel-title">@Model.HotelName</h1>

                    <p class="mb-0 text-secondary">
                        <i class="bi bi-star-fill text-warning"></i>
                        Tripadvisor misafir değerlendirmesi
                    </p>
                </div>

                <div class="d-flex align-items-center gap-3">
                    <div class="rating-info">
                        <strong>Misafir Puanı</strong>
                        <small>
                            @(Model.ReviewCount?.ToString("N0") ?? "0") değerlendirme
                        </small>
                    </div>

                    <span class="rating-score">
                        @(Model.ReviewScore?.ToString("0.0") ?? "-")
                    </span>
                </div>
            </section>

            <!-- Otel fotoğraf galerisi -->
            <section class="hotel-gallery" aria-label="Otel fotoğrafları">

                @if (photoUrls.Any())
                {
                    @for (int i = 0; i < photoUrls.Count && i < 5; i++)
                    {
                        <a href="@photoUrls[i]"
                           target="_blank"
                           class="gallery-item">

                            <img src="@photoUrls[i]"
                                 alt="@Model.HotelName fotoğrafı"
                                 loading="lazy">
                        </a>
                    }
                }
                else
                {
                    <p class="empty-message">Bu otel için fotoğraf bulunamadı.</p>
                }

            </section>

            <div class="row g-4">

                <div class="col-lg-8">

                    <!-- Otel hakkında -->
                    <section class="detail-block" id="about">
                        <h2 class="block-title">
                            <i class="bi bi-info-circle me-2"></i>
                            Otel Hakkında
                        </h2>

                        @if (!string.IsNullOrWhiteSpace(Model.Description))
                        {
                            <div class="about-text">
                                @Model.Description
                            </div>
                        }
                        else
                        {
                            <p class="empty-message">
                                Otel açıklaması bulunamadı.
                            </p>
                        }

                        @if (tags.Any())
                        {
                            <ul class="tag-list">
                                @foreach (var tag in tags)
                                {
                                    <li>
                                        <i class="bi bi-tag me-1"></i>
                                        @tag
                                    </li>
                                }
                            </ul>
                        }
                    </section>

                    <!-- Otel özellikleri -->
                    <section class="detail-block" id="facilities">
                        <h2 class="block-title">
                            <i class="bi bi-stars me-2"></i>
                            Otel Özellikleri
                        </h2>

                        @if (facilities.Any())
                        {
                            <div class="row g-2">
                                @foreach (var facility in facilities)
                                {
                                    <div class="col-6 col-md-4">
                                        <div class="facility-item">
                                            <span class="facility-icon">
                                                <i class="bi bi-check-circle"></i>
                                            </span>

                                            <span class="facility-text">
                                                <strong>@facility</strong>
                                            </span>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <p class="empty-message">
                                Otel özellikleri bulunamadı.
                            </p>
                        }
                    </section>

                    <!-- Fotoğraf galerisi -->
                    <section class="detail-block" id="hotelPhotos">

                        <div class="d-flex justify-content-between align-items-center gap-3 mb-4">
                            <div>
                                <h2 class="block-title mb-1">
                                    Otel Fotoğrafları
                                </h2>
                                <p class="text-secondary mb-0">
                                    Otelin fotoğraflarını inceleyin.
                                </p>
                            </div>

                            <div class="d-flex gap-2">
                                <button type="button"
                                        class="slider-btn"
                                        data-dir="-1"
                                        aria-label="Önceki fotoğraflar">
                                    <i class="bi bi-chevron-left"></i>
                                </button>

                                <button type="button"
                                        class="slider-btn"
                                        data-dir="1"
                                        aria-label="Sonraki fotoğraflar">
                                    <i class="bi bi-chevron-right"></i>
                                </button>
                            </div>
                        </div>

                        <div class="photo-track" id="photoTrack">

                            @foreach (var photo in photoUrls)
                            {
                                <figure class="photo-item">
                                    <a href="@photo"
                                       target="_blank"
                                       class="photo-frame">
                                        <img src="@photo"
                                             alt="@Model.HotelName"
                                             loading="lazy">
                                    </a>

                                    <figcaption>
                                        <strong>@Model.HotelName</strong>
                                        Otel fotoğrafı
                                    </figcaption>
                                </figure>
                            }

                        </div>

                        @if (!photoUrls.Any())
                        {
                            <p class="empty-message">
                                Gösterilecek fotoğraf bulunamadı.
                            </p>
                        }

                    </section>

                </div>

                <!-- Sağ kolon: değerlendirme özeti -->
                <aside class="col-lg-4">
                    <div class="detail-block">
                        <h2 class="block-title">
                            Misafir Değerlendirmesi
                        </h2>

                        <div class="text-center py-3">
                            <div class="display-4 fw-bold"
                                 style="color:var(--sf-primary)">
                                @(Model.ReviewScore?.ToString("0.0") ?? "-")
                            </div>

                            <div class="text-warning mb-2">
                                <i class="bi bi-star-fill"></i>
                                <i class="bi bi-star-fill"></i>
                                <i class="bi bi-star-fill"></i>
                                <i class="bi bi-star-fill"></i>
                                <i class="bi bi-star"></i>
                            </div>

                            <strong style="color:var(--sf-ink)">
                                Tripadvisor puanı
                            </strong>

                            <p class="text-secondary mt-2 mb-0">
                                @(Model.ReviewCount?.ToString("N0") ?? "0")
                                değerlendirme
                            </p>
                        </div>

                        <hr>

                        <p class="text-secondary small mb-0">
                            Bu puan ve değerlendirme sayısı otel detay API
                            cevabından alınmıştır.
                        </p>
                    </div>
                </aside>

            </div>
        </div>
    </main>

    <footer class="site-footer">
        <div class="container">
            <a class="brand text-white"
               asp-controller="Booking"
               asp-action="Index">
                <span class="brand-mark">
                    <i class="bi bi-geo-alt-fill"></i>
                </span>
                <span>Stay<span>Finder</span></span>
            </a>

            <p>Bir sonraki konaklaman için doğru oteli keşfet.</p>

            <hr class="border-secondary">

            <small>© 2026 StayFinder. Tüm hakları saklıdır.</small>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        (function () {
            const track = document.getElementById("photoTrack");

            if (!track) return;

            document.querySelectorAll(".slider-btn").forEach(function (button) {
                button.addEventListener("click", function () {
                    const item = track.querySelector(".photo-item");
                    const gap = parseFloat(getComputedStyle(track).columnGap) || 0;
                    const step = item ? item.offsetWidth + gap : track.clientWidth;

                    track.scrollBy({
                        left: step * Number(button.dataset.dir),
                        behavior: "smooth"
                    });
                });
            });
        })();
    </script>

</body>
</html>

