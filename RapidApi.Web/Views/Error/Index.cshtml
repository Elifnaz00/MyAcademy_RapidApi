@{
    ViewData["Title"] = "Bir Hata Oluştu";
}

<div class="container py-5 text-center">

    <div class="mb-4">
        <h1 class="display-3 fw-bold text-danger">
            @ViewBag.StatusCode
        </h1>
    </div>

    <h2 class="mb-3">Bir şeyler ters gitti!</h2>

    <p class="text-muted mb-4">
        @(ViewBag.ErrorMessage ??
                "İşleminiz sırasında beklenmeyen bir hata oluştu.")
    </p>

    <a asp-controller="Booking"
       asp-action="Index"
       class="btn btn-primary">
        Ana Sayfaya Dön
    </a>

</div>